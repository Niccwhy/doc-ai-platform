# ============================================================
# doc-ai-platform 环境变量模板
# 使用方式：复制本文件为 .env（在项目根目录），填入真实值。
#   cp .env.example .env        （Git Bash / Linux / macOS）
#   copy .env.example .env      （Windows CMD）
# .env 已被 .gitignore 排除，不会提交到 GitHub。
# ============================================================

# ---------- 服务端口（docker compose 使用） ----------
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_UI_PORT=9001
REDIS_PORT=6379
APP_PORT=8080
WEB_PORT=8081

# ---------- 数据库（PostgreSQL + pgvector） ----------
POSTGRES_DB=docai
POSTGRES_USER=docai
POSTGRES_PASSWORD=docai123

# ---------- 对象存储（silo / MinIO 兼容） ----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=docai

# ---------- LLM 对话（DeepSeek） ----------
# >>> 【需要你自己填写】在 DeepSeek 开放平台申请：https://platform.deepseek.com/api_keys
# >>> 填到 .env 本行等号后面。留空则系统自动降级为 Mock（返回 null，便于联调）。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ---------- Embedding 向量化（阿里云通义 / DashScope） ----------
# >>> 【需要你自己填写】在阿里云百炼申请：https://bailian.console.aliyun.com/
# >>> 填到 .env 本行等号后面。留空则向量检索不可用（降级为关键词召回）。
EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1536

# ---------- 认证（JWT） ----------
# >>> 【需要你自己改】至少 32 个字符，生产环境必须换成随机值
JWT_SECRET=doc-ai-platform-local-dev-secret-key-change-me-2026
JWT_EXPIRATION_MINUTES=720

# ---------- 初始账号（首次启动自动创建） ----------
# >>> 【建议修改】上线前务必改掉默认密码
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123
INIT_DEMO_USERS=true

# ---------- 邮件接入（部门邮箱，按需配置） ----------
# 每个部门在系统内配置 IMAP；此处仅为部署时的默认值示例
# IMAP_HOST=imap.qq.com
# IMAP_PORT=993
# IMAP_AUTH_CODE=

